{
  "name": "local-drop",
  "version": "1.0.0",
  "description": "Herramienta local, segura y efímera de transferencia inalámbrica de archivos",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [ "server.js" ],
    "assets": [ "public/**/*" ],
    "targets": [ "node18-win-x64", "node18-macos-x64", "node18-linux-x64" ]
  }
}